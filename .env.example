PORT=8080
TZ=Europe/Lisbon
LATITUDE=38.697
LONGITUDE=-9.310
CITY=Oeiras
PUBLICO_RSS_URL=https://news.google.com/rss/search?q=site:publico.pt&hl=pt-PT&gl=PT&ceid=PT:pt
EXPRESSO_RSS_URL=https://news.google.com/rss/search?q=site:expresso.pt&hl=pt-PT&gl=PT&ceid=PT:pt

# Secret Google Calendar ICS URL(s), comma-separated. Never commit the value.
CALENDAR_ICS_URL=

# Optional extra ICS feeds (Online, feriados, etc.)
CALENDAR_ICS_URLS=

# Optional IMAP for Email Meter (Gmail app password). Leave empty to show the empty state.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=

# Optional Zoho Books (AR screen). Empty = empty state.
ZOHO_BOOKS_ORG_ID=
ZOHO_BOOKS_REFRESH_TOKEN=
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=

# Optional OpenRouter. Empty = empty state.
OPENROUTER_API_KEY=

# Existing lgdash tokens — do not rotate. iPad web clip uses /legacy.html?k=DASH_TOKEN
DASH_TOKEN=
PUSH_TOKEN=
